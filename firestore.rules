rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/projects/{projectId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function shortText(value) { return value is string && value.size() > 0 && value.size() <= 200; }
      function validFields(f) {
        return f == null || (f is map
          && f.keys().hasAll(['image', 'question', 'answer', 'list'])
          && f.keys().hasOnly(['image', 'question', 'answer', 'list'])
          && shortText(f.image) && shortText(f.question) && shortText(f.answer)
          && (f.list == null || shortText(f.list)));
      }
      function validDataset(d) {
        return d is map && d.keys().hasAll(['repo', 'config', 'split', 'fields'])
          && d.keys().hasOnly(['repo', 'config', 'split', 'fields'])
          && shortText(d.repo) && (d.config == null || shortText(d.config))
          && (d.split == null || shortText(d.split)) && validFields(d.fields);
      }
      function validProject() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion', 'name', 'createdAt', 'updatedAt', 'templateId', 'nodes', 'edges', 'classes', 'settings'])
          && d.keys().hasOnly(['schemaVersion', 'name', 'createdAt', 'updatedAt', 'templateId', 'nodes', 'edges', 'classes', 'settings', 'dataset'])
          && d.schemaVersion in [1, 2]
          && ((!('dataset' in d) && d.schemaVersion == 1) || ('dataset' in d && validDataset(d.dataset)))
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && (d.templateId == null || d.templateId is string)
          && d.nodes is list && d.nodes.size() <= 500
          && d.edges is list && d.edges.size() <= 1000
          && d.classes is list && d.classes.size() <= 100
          && d.settings is map
          && d.settings.keys().hasAll(['epochs', 'batchSize', 'learningRate'])
          && d.settings.keys().hasOnly(['epochs', 'batchSize', 'learningRate'])
          && d.settings.epochs is int && d.settings.epochs >= 1 && d.settings.epochs <= 10000
          && d.settings.batchSize is int && d.settings.batchSize >= 1 && d.settings.batchSize <= 10000
          && d.settings.learningRate is number && d.settings.learningRate > 0 && d.settings.learningRate <= 1
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validProject() && request.resource.data.createdAt == request.time;
      allow update: if owner() && validProject() && request.resource.data.createdAt == resource.data.createdAt;
      // Delete and sharing are outside this MVP. All other paths are denied by default.
    }
  }
}
